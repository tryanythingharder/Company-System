# 生产构建覆盖（pig-ui 静态产物）
# 1) pig-boot 是单体，context-path=/admin；true 会让 adaptationUrl 走微服务分支，相对路径不会补 /admin。
VITE_IS_MICRO=false
# 2) 后端 captcha_flag=0，没有 /auth/code/* 实现；若以后启用验证码，需后端补齐接口后删除本行。
VITE_LOGIN_CAPTCHA=off
# 3) 生产加固：前端产物不含任何 OAuth 客户端凭证。
#    登录/刷新/注销都走后端 /admin/auth/*，客户端密钥只在服务端（MOLD_AUTH_CLIENT_SECRET）。
#    这里只保留客户端 ID（系统设置页展示用），短信/社交客户端已在库中删除。
VITE_OAUTH2_PASSWORD_CLIENT=mold
VITE_OAUTH2_MOBILE_CLIENT=
VITE_OAUTH2_SOCIAL_CLIENT=
# 4) 报文加密未启用（VITE_API_ENC_ENABLED 未设置）；该密钥会打进产物，不能作为安全边界，生产置空。
VITE_PWD_ENC_KEY=
# 5) 请求超时 20 秒（上游默认 50 秒过长）
VITE_REQUEST_TIMEOUT=20000
